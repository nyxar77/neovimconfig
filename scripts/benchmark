#!/usr/bin/env bash
set -euo pipefail

config_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
benchmark_root="$(mktemp -d -t neovimconfig-benchmark.XXXXXXXXXX)"
nvim_bin="${NVIM_BIN:-nvim}"
plugin_pack="${NVIM_PLUGIN_PACK:-${XDG_DATA_HOME:-$HOME/.local/share}/nvim/site/pack/hm}"
runs="${NVIM_BENCHMARK_RUNS:-10}"
baseline_ms="${NVIM_STARTUP_BASELINE_MS:-500}"
warning_percent="${NVIM_STARTUP_WARNING_PERCENT:-20}"
failure_percent="${NVIM_STARTUP_FAILURE_PERCENT:-50}"
warning_ms="$(awk -v baseline="$baseline_ms" -v percent="$warning_percent" 'BEGIN { printf "%.3f", baseline * (100 + percent) / 100 }')"
failure_ms="$(awk -v baseline="$baseline_ms" -v percent="$failure_percent" 'BEGIN { printf "%.3f", baseline * (100 + percent) / 100 }')"

cleanup() {
  rm -rf -- "$benchmark_root"
}
trap cleanup EXIT

if [[ ! -d "$plugin_pack" ]]; then
  printf 'error: Neovim plugin pack not found: %s\n' "$plugin_pack" >&2
  exit 1
fi

mkdir -p "$benchmark_root/cache" "$benchmark_root/config" "$benchmark_root/data/nvim/site/pack" "$benchmark_root/state"
ln -s "$config_root/nvim" "$benchmark_root/config/nvim"
ln -s "$plugin_pack" "$benchmark_root/data/nvim/site/pack/hm"

export NVIM_LOG_FILE="$benchmark_root/nvim.log"
export XDG_CACHE_HOME="$benchmark_root/cache"
export XDG_CONFIG_HOME="$benchmark_root/config"
export XDG_DATA_HOME="$benchmark_root/data"
export XDG_STATE_HOME="$benchmark_root/state"

times_file="$benchmark_root/times"
for ((run = 1; run <= runs; run++)); do
  startup_file="$benchmark_root/startup-$run.log"
  "$nvim_bin" --headless -i NONE --startuptime "$startup_file" "$config_root/README.md" "+qa!"
  awk '/--- NVIM STARTED ---/ { value = $1 } END { print value }' "$startup_file" >>"$times_file"
done

if grep -qvE '^[0-9]+([.][0-9]+)?$' "$times_file"; then
  printf 'error: Neovim produced an invalid startup-time measurement\n' >&2
  exit 1
fi

median_ms="$(sort -n "$times_file" | awk '{ values[NR] = $1 } END { if (NR % 2) print values[(NR + 1) / 2]; else printf "%.3f", (values[NR / 2] + values[NR / 2 + 1]) / 2 }')"
maximum_ms="$(sort -n "$times_file" | tail -n 1)"

printf 'Neovim startup: median=%sms maximum=%sms runs=%s baseline=%sms\n' \
  "$median_ms" "$maximum_ms" "$runs" "$baseline_ms"

if awk -v measured="$median_ms" -v threshold="$failure_ms" 'BEGIN { exit !(measured > threshold) }'; then
  printf 'error: median startup time %sms exceeds the %s%% regression limit (%sms)\n' \
    "$median_ms" "$failure_percent" "$failure_ms" >&2
  exit 1
fi

if awk -v measured="$median_ms" -v threshold="$warning_ms" 'BEGIN { exit !(measured > threshold) }'; then
  if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
    printf '::warning title=Neovim startup regression::Median startup time is %sms; warning limit is %s%% above the %sms baseline.\n' \
      "$median_ms" "$warning_percent" "$baseline_ms"
  else
    printf 'warning: median startup time %sms is more than %s%% above the %sms baseline\n' \
      "$median_ms" "$warning_percent" "$baseline_ms" >&2
  fi
fi

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  {
    printf '### Neovim startup performance\n\n'
    printf '| Median | Maximum | Runs | Baseline | Warning | Failure |\n'
    printf '|---:|---:|---:|---:|---:|---:|\n'
    printf '| %sms | %sms | %s | %sms | +%s%% | +%s%% |\n' \
      "$median_ms" "$maximum_ms" "$runs" "$baseline_ms" "$warning_percent" "$failure_percent"
  } >>"$GITHUB_STEP_SUMMARY"
fi
